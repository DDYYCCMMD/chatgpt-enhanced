{
  "manifest_version": 3,
  "name": "ChatGPT Enhanced",
  "version": "0.3.0",
  "description": "Navigate rendered conversation questions and customize ChatGPT Project and Chat colors.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "action": {
    "default_title": "ChatGPT Enhanced",
    "default_popup": "src/popup/index.html"
  },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
