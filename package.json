{
  "name": "chatgpt-enhanced",
  "version": "0.2.0",
  "private": true,
  "description": "A modular Chrome extension for ChatGPT.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.30",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.19.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
